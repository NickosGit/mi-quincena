# Copy to .env.local and fill in. Never commit .env.local.
# On Vercel: Settings -> Environment Variables (same names).

# Public (shipped to the browser). The anon key is public by design: RLS separates users' data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never prefix with NEXT_PUBLIC.
GEMINI_API_KEY=
# Exact ID of the current free-tier Flash model in Google AI Studio.
GEMINI_MODEL=

# There is deliberately no SUPABASE_SERVICE_ROLE_KEY: the app never uses it.
